{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Qyflux",
  "version": "0.1.0",
  "identifier": "studio.qyflux.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Qyflux", "width": 1120, "height": 760, "minWidth": 900, "minHeight": 650, "center": true, "decorations": false, "transparent": true, "backgroundColor": "#00000000", "visible": false }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/backgrounds/**", "$APPDATA/icons/**"] }
    }
  },
  "bundle": { "active": false }
}
